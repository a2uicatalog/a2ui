var SceneStage = (function () {
'use strict';
/* scene-atom: theme prompt -> validated scene spec -> pan/zoom/animated SVG.
 *
 * Pipeline (every arrow is a checked boundary):
 *   prompt --interpretPrompt()--> spec --validateSpec()--> spec'
 *   registry.json --verifyRegistry()--> trusted props
 *   (spec', props) --buildScene()--> standalone animated SVG + provenance
 *
 * Nothing the user or an LLM types ever reaches the SVG as markup: the spec is
 * strictly typed data, artwork comes only from the hash-verified registry, and
 * every string that is emitted is escaped or numeric.
 */

const RENDERER_VERSION = '1.0.0';
const SVG_NS = 'http://www.w3.org/2000/svg';

/* ------------------------------------------------------------------ utils */
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const lerp = (a, b, t) => a + (b - a) * t;
const smooth = (t) => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
const fmt = (n) => String(Math.round(n * 10) / 10);
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function rng(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const hex2rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const mix = (a, b, t) => {
  const A = hex2rgb(a), B = hex2rgb(b);
