}

/* --------------------------------------------------- registry verification */
const TOKEN_RE = /\{\{([a-z]+)\}\}/g;
const BAD_VALUE_RE = /(javascript|data|vbscript)\s*:|expression\s*\(|@import|</i;

function svgProblems(text, allow) {
  const doc = (function () { throw new Error('SVG structure checks need a DOM; this build verifies sha256 and origin only'); })();
  if (doc.getElementsByTagName('parsererror').length) return ['not well-formed XML'];
  const problems = [];
  const root = doc.documentElement;
  if (root.namespaceURI !== SVG_NS || root.localName !== 'svg') problems.push('root must be <svg>');
  if (!root.getAttribute('viewBox')) problems.push('root <svg> needs a viewBox');
  for (const m of text.matchAll(TOKEN_RE)) if (!allow.tokens.includes(m[1])) problems.push(`unknown token {{${m[1]}}}`);
  if ((text.match(/\{\{/g) || []).length !== [...text.matchAll(TOKEN_RE)].length) problems.push('malformed {{token}}');
  const all = [root, ...root.querySelectorAll('*')];
  for (const el of all) {
    if (el.namespaceURI !== SVG_NS || !allow.elements.includes(el.localName)) problems.push(`element <${el.localName}> not allowed`);
    for (const a of el.attributes) {
      const isRootSpecial = el === root && (a.name === 'xmlns' || a.name === 'viewBox');
      if (!isRootSpecial && (a.namespaceURI || !allow.attributes.includes(a.localName))) {
        problems.push(`attribute ${a.name} on <${el.localName}> not allowed`);
        continue;
      }
      if (BAD_VALUE_RE.test(a.value)) problems.push(`unsafe value in ${a.name}`);
      for (const u of a.value.matchAll(/url\(([^)]*)\)/gi)) if (!u[1].trim().startsWith('#')) problems.push(`external url() in ${a.name}`);
    }
  }
  return problems;
}

/** Re-verify the ledger in the browser: hash, licence, origin fields, SVG safety. Throws on any failure.
 *  `skipSvgStructure` exists only for DOM-less tooling (Node CI, golden tests): the sha256 and origin checks still run, and the
 *  structural allowlist pass was done by build_registry.py when the hash was minted. A DOM-less production renderer needs a real XML parser instead. */
function verifyRegistry(reg, allow, { skipSvgStructure = false } = {}) {
  const errs = [];
  const seen = new Set();
  if (!reg || reg.schema !== 1 || !Array.isArray(reg.entries)) throw new Error('registry: bad schema');
  for (const e of reg.entries) {
    const tag = `registry[${e && e.id}]`;
    if (!e || !/^[a-z0-9-]+$/.test(e.id) || seen.has(e.id)) { errs.push(`${tag}: bad or duplicate id`); continue; }
    seen.add(e.id);
    if (typeof e.svg !== 'string') { errs.push(`${tag}: missing svg`); continue; }
    if (sha256Hex(e.svg) !== e.sha256) errs.push(`${tag}: sha256 mismatch (artwork changed without a provenance update)`);
    const o = e.origin || {};
    if (!allow.licenses.includes(o.license)) errs.push(`${tag}: licence ${o.license} not allowed`);
    if (!o.author) errs.push(`${tag}: no author`);
    if (o.type === 'third-party') {
      if (!/^https:\/\//.test(o.source_url || '')) errs.push(`${tag}: third-party art needs https source_url`);
      if (!o.retrieved) errs.push(`${tag}: third-party art needs retrieved date`);
      if (allow.attribution_required.includes(o.license) && !o.attribution) errs.push(`${tag}: licence requires attribution`);
    } else if (o.type !== 'original') errs.push(`${tag}: origin.type invalid`);
    if (!skipSvgStructure) errs.push(...svgProblems(e.svg, allow).map((p) => `${tag}: ${p}`));
    const tokenMap = (map, where) => {
      for (const [k, v] of Object.entries(map || {})) {
        if (!allow.tokens.includes(k)) errs.push(`${tag}: ${where} has unknown token ${k}`);
        if (typeof v !== 'string' || !new RegExp(allow.token_value_pattern).test(v)) errs.push(`${tag}: ${where} token ${k} must be #rrggbb or 0/1`);
      }
    };
    if (!allow.categories.includes(e.category)) errs.push(`${tag}: category ${e.category} is not allowed`);
    if (!Array.isArray(e.tags) || e.tags.length < 1 || e.tags.length > 10 || new Set(e.tags).size !== e.tags.length || !e.tags.every((t) => typeof t === 'string' && /^[a-z0-9-]{2,24}$/.test(t))) errs.push(`${tag}: tags must be 1-10 distinct lowercase words`);
    if ('library' in e && e.library !== true) errs.push(`${tag}: library, when present, must be true`);
    if ('promoted' in e && (e.promoted !== true || e.library !== true)) errs.push(`${tag}: promoted, when present, must be true and only applies to library props`);
    tokenMap(e.tokens, 'tokens');
    for (const [name, map] of Object.entries(e.variants || {})) {
      if (!/^[a-z0-9-]+$/.test(name)) errs.push(`${tag}: bad variant name ${name}`);
      tokenMap(map, `variant ${name}`);
      for (const k of Object.keys(map)) if (!e.svg.includes(`{{${k}}}`)) errs.push(`${tag}: variant ${name} sets ${k}, which this prop never uses`);
    }
    const resolvable = new Set([...allow.palette_tokens, ...Object.keys(e.tokens || {})]);
    for (const m of e.svg.matchAll(TOKEN_RE)) if (!resolvable.has(m[1])) errs.push(`${tag}: token {{${m[1]}}} has no default`);
  }
  for (const e of reg.entries) for (const r of e.requires || []) if (!seen.has(r)) errs.push(`registry[${e.id}]: requires unknown ${r}`);
  if (errs.length) throw new Error('Registry verification failed:\n' + errs.join('\n'));
  return true;
}


/** Pure half of loadAtom (no fetch, no DOM): verifies the registry and returns the atom. Used by Node tooling and renderers. */
function atomFromTexts(regText, allowText, layoutsText, opts) {
  const registry = JSON.parse(regText);
  const allow = JSON.parse(allowText);
  verifyRegistry(registry, allow, opts);
  const byId = Object.fromEntries(registry.entries.map((e) => [e.id, e]));
  const layouts = JSON.parse(layoutsText);          // presets only supply defaults; every spec built from them is still fully validated
  return { registry, allow, byId, layouts, registrySha256: sha256Hex(regText) };
}

/**
 * The smallest self-contained input a renderer needs for one spec: only the registry entries the scene draws (with their
 * own sha256, so they are re-verified), the allowlist, and the one layout the spec names. registry_sha256 is the FULL
 * registry's hash, so provenance is identical to a build from the whole kit.
 */
function bundleFor(specIn, atom) {
  const r = buildScene(specIn, atom);
  const ids = new Set();
  const add = (id) => { if (ids.has(id)) return; ids.add(id); for (const q of atom.byId[id].requires || []) add(q); };
  r.provenance.assets.forEach((a) => add(a.id));
  const preset = specIn && specIn.preset;
  return {
    schema: 1, registry_sha256: atom.registrySha256, allow: atom.allow,
    entries: atom.registry.entries.filter((e) => ids.has(e.id)),
    layouts: { version: 1, layouts: preset && atom.layouts.layouts[preset] ? { [preset]: atom.layouts.layouts[preset] } : {} },
  };
}

/** Rebuild an atom from a bundleFor() result; every entry is verified exactly as in the full registry. */
function atomFromBundle(b, opts) {
  const registry = { schema: 1, entries: b.entries };
  verifyRegistry(registry, b.allow, opts);
  return { registry, allow: b.allow, byId: Object.fromEntries(registry.entries.map((e) => [e.id, e])), layouts: b.layouts, registrySha256: b.registry_sha256 };
}

