{
 "note": "RFC 6902 Appendix A (A.13 is about duplicate member names, resolved by the JSON parser before a patch exists) plus conformance cases from sections 4 and RFC 6901. expected \"error\" means the whole patch is rejected.",
 "cases": [
  {
   "id": "A.1",
   "doc": {
    "foo": "bar"
   },
   "patch": [
    {
     "op": "add",
     "path": "/baz",
     "value": "qux"
    }
   ],
   "expected": {
    "baz": "qux",
    "foo": "bar"
   },
   "source": "RFC 6902 Appendix A.1"
  },
  {
   "id": "A.2",
   "doc": {
    "foo": [
     "bar",
     "baz"
    ]
   },
   "patch": [
    {
     "op": "add",
     "path": "/foo/1",
     "value": "qux"
    }
   ],
   "expected": {
    "foo": [
     "bar",
     "qux",
     "baz"
    ]
   },
   "source": "RFC 6902 Appendix A.2"
  },
  {
   "id": "A.3",
   "doc": {
    "baz": "qux",
    "foo": "bar"
   },
   "patch": [
    {
     "op": "remove",
     "path": "/baz"
    }
   ],
   "expected": {
    "foo": "bar"
   },
   "source": "RFC 6902 Appendix A.3"
  },
  {
   "id": "A.4",
   "doc": {
    "foo": [
     "bar",
     "qux",
     "baz"
    ]
   },
   "patch": [
    {
     "op": "remove",
     "path": "/foo/1"
    }
   ],
   "expected": {
    "foo": [
     "bar",
     "baz"
    ]
   },
   "source": "RFC 6902 Appendix A.4"
  },
  {
   "id": "A.5",
   "doc": {
    "baz": "qux",
    "foo": "bar"
   },
   "patch": [
    {
     "op": "replace",
     "path": "/baz",
     "value": "boo"
    }
   ],
   "expected": {
    "baz": "boo",
    "foo": "bar"
   },
   "source": "RFC 6902 Appendix A.5"
  },
  {
   "id": "A.6",
   "doc": {
    "foo": {
     "bar": "baz",
     "waldo": "fred"
    },
    "qux": {
     "corge": "grault"
    }
   },
   "patch": [
    {
     "op": "move",
     "from": "/foo/waldo",
     "path": "/qux/thud"
    }
   ],
   "expected": {
    "foo": {
     "bar": "baz"
    },
    "qux": {
     "corge": "grault",
     "thud": "fred"
    }
   },
   "source": "RFC 6902 Appendix A.6"
  },
  {
   "id": "A.7",
   "doc": {
    "foo": [
     "all",
     "grass",
     "cows",
     "eat"
    ]
   },
   "patch": [
    {
     "op": "move",
     "from": "/foo/1",
     "path": "/foo/3"
    }
   ],
   "expected": {
    "foo": [
     "all",
     "cows",
     "eat",
     "grass"
    ]
   },
   "source": "RFC 6902 Appendix A.7"
  },
  {
   "id": "A.8",
   "doc": {
    "baz": "qux",
    "foo": [
     "a",
     2,
     "c"
    ]
   },
   "patch": [
    {
     "op": "test",
     "path": "/baz",
     "value": "qux"
    },
    {
     "op": "test",
     "path": "/foo/1",
     "value": 2
    }
   ],
   "expected": {
    "baz": "qux",
    "foo": [
     "a",
     2,
     "c"
    ]
   },
   "source": "RFC 6902 Appendix A.8"
  },
  {
   "id": "A.9",
   "doc": {
    "baz": "qux"
   },
   "patch": [
    {
     "op": "test",
     "path": "/baz",
     "value": "bar"
    }
   ],
   "expected": "error",
   "source": "RFC 6902 Appendix A.9"
  },
  {
   "id": "A.10",
   "doc": {
    "foo": "bar"
   },
   "patch": [
    {
     "op": "add",
     "path": "/child",
     "value": {
      "grandchild": {}
     }
    }
   ],
   "expected": {
