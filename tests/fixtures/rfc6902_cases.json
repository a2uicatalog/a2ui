   "source": "RFC 6902 Appendix A.11"
  },
  {
   "id": "A.12",
   "doc": {
    "foo": "bar"
   },
   "patch": [
    {
     "op": "add",
     "path": "/baz/bat",
     "value": "qux"
    }
   ],
   "expected": "error",
   "source": "RFC 6902 Appendix A.12"
  },
  {
