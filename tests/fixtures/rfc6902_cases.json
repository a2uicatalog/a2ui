   "source": "RFC 6902 Appendix A.14"
  },
  {
   "id": "A.15",
   "doc": {
    "/": 9,
    "~1": 10
   },
   "patch": [
    {
     "op": "test",
     "path": "/~01",
     "value": "10"
    }
   ],
   "expected": "error",
   "source": "RFC 6902 Appendix A.15"
  },
  {
   "id": "A.16",
   "doc": {
    "foo": [
     "bar"
    ]
   },
   "patch": [
    {
     "op": "add",
     "path": "/foo/-",
     "value": [
      "abc",
