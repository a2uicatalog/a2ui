%% request: event-driven order pipeline with kafka
flowchart LR
    classDef svc fill:#e3f2fd,stroke:#1565c0
    classDef topic fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef db fill:#f3e5f5,stroke:#6a1b9a
    classDef dlq fill:#ffebee,stroke:#c62828,stroke-dasharray: 5 5

    Client([Web / Mobile Client])
    GW[API Gateway]:::svc

    subgraph Producers
        OS[Order Service]:::svc
    end

    subgraph Kafka["Apache Kafka Cluster"]
        T1>orders.created]:::topic
        T2>inventory.reserved]:::topic
        T3>payment.completed]:::topic
        T4>order.confirmed]:::topic
        DLQ>orders.dlq]:::dlq
    end

    subgraph Consumers
        INV[Inventory Service]:::svc
        PAY[Payment Service]:::svc
        SHIP[Shipping Service]:::svc
        NOTIF[Notification Service]:::svc
        ANA[Analytics Sink]:::svc
    end

    ODB[(Orders DB)]:::db
    IDB[(Inventory DB)]:::db
    PDB[(Payments DB)]:::db
    DW[(Data Warehouse)]:::db

    Client -->|POST /orders| GW --> OS
    OS --> ODB
    OS -->|publish| T1
    T1 -->|consume| INV
    INV --> IDB
    INV -->|publish| T2
    T2 --> PAY
    PAY --> PDB
    PAY -->|publish| T3
    T3 --> OS
    OS -->|publish| T4
    T4 --> SHIP
    T4 --> NOTIF
    T1 -.-> ANA
    T4 -.-> ANA
    ANA --> DW
    INV -. failed .-> DLQ
    PAY -. failed .-> DLQ
