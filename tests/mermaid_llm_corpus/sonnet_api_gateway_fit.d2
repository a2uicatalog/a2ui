# request: microservices behind an API gateway
# fixed from tool errors
direction: right

clients: Clients (Web, Mobile, Partner API) {shape: rectangle}

gateway: API Gateway {
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"
  style.stroke-width: 2
  auth: Authentication
  rate: Rate Limiter
  route: Router
  auth -> rate -> route
}

services: Microservices {
  style.fill: "#e3f2fd"
  users: User Service
  orders: Order Service
  catalog: Catalog Service
  payments: Payment Service
}

data: Data Stores (Users, Orders, Catalog DBs, Redis) {shape: cylinder; style.fill: "#f3e5f5"}
bus: Message Bus {shape: queue; style.fill: "#e8f5e9"}
idp: Identity Provider {shape: hexagon}

clients -> gateway.auth: HTTPS / API key
gateway.auth -> idp: validate token {style.stroke-dash: 3}
gateway.route -> services.users: /users
gateway.route -> services.orders: /orders
gateway.route -> services.catalog: /catalog
services.users -> data
services.orders -> data
services.catalog -> data: DB + cache
services.orders -> services.payments: charge
services.orders -> bus: order.created
bus -> services.payments
