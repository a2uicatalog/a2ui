%% request: RAG chatbot architecture
%% fixed from tool errors
flowchart TB
    classDef ingest fill:#e8f5e9,stroke:#2e7d32
    classDef query fill:#e3f2fd,stroke:#1565c0
    classDef store fill:#f3e5f5,stroke:#6a1b9a
    classDef llm fill:#fff3e0,stroke:#ef6c00,stroke-width:2px

    SRC[(Confluence, PDF / Docs, Website crawl)]:::ingest
    ING["Offline ingestion: parse and clean,<br/>chunk 512 tokens, embed"]:::ingest
    VDB[(Vector DB + metadata store<br/>pgvector / Pinecone)]:::store
    SRC --> ING --> VDB

    U([User]) --> API["Chat UI + API / Orchestrator<br/>(conversation memory, logging)"]:::query
    API --> QR["Query rewrite using chat history,<br/>embed query"]:::query
    QR --> RET{{Hybrid retrieval<br/>vector + BM25}}:::query
    VDB --> RET
    RET --> RR[Reranker<br/>cross-encoder]:::query
    RR --> PB["Prompt builder<br/>system + context + question"]:::query
    PB --> LLM[[LLM]]:::llm
    LLM --> GR{Guardrails ok?}:::query
    GR -- yes, answer + citations --> API
    GR -- no --> FB[Fallback answer]:::query
    FB --> API
