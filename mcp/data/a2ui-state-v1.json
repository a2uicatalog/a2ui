{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://a2uicatalog.ai/catalogue/a2ui-state-v1.json",
 "protocolVersion": "1.0",
 "catalogId": "https://a2uicatalog.ai/catalogue/a2ui-state-v1.json",
 "title": "A2UI State & Expression Vocabulary",
 "description": "Behavioral primitives an agent wires into a payload's state_primitives array, plus the expression ops and column render hints. A payload has three sections — state_primitives, actions, layout — and layout atoms subscribe to primitive/action outputs via wires.",
 "instructions": "A2UI **behavioral** catalog — the companion to the visual atom catalog `a2ui-atoms-v1`. A wired surface declares `supportedCatalogIds: [a2ui-atoms-v1, a2ui-state-v1]`: atoms are the visual vocabulary, these `components` (state primitives + column render-hints) and `functions` (derived-store ops) are the behavioral one.\n\nWire syntax: `#nodeId.field` — the `#` prefix is required. Atoms in `layout` use `wire` to subscribe to a primitive/action output field.\n\nFull prose descriptions, examples, and wiring patterns: see https://a2uicatalog.ai/spec.json and the a2ui-state spec.",
 "components": {
  "ValueStore": {
   "type": "object",
   "description": "mutable named value; holds user input or transient state",
   "properties": {
    "component": {
     "const": "ValueStore"
    },
    "initialValue": {
     "description": "any (optional, default null)"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "value"
   ],
   "x-actionTargets": [
    "setValue"
   ]
  },
  "Timer": {
   "type": "object",
   "description": "fires a tick on a fixed interval; triggers queries or actions",
   "properties": {
    "component": {
     "const": "Timer"
    },
    "interval": {
     "description": "integer ms, default 10000"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "tick"
   ]
  },
  "DerivedStore": {
   "type": "object",
   "description": "computes augmented data from a source array client-side; no server call",
   "properties": {
    "component": {
     "const": "DerivedStore"
    },
    "from": {
     "description": "string — source ref e.g. #incidents_query.result"
    },
    "expr": {
     "description": "augment_rows — maps over source array, adds computed columns"
    },
    "interval": {
     "description": "integer ms (optional) — re-run on tick; only for time-dependent ops"
    },
    "add": {
     "description": "array of op definitions (see derived_store_ops)"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "result"
   ]
  },
  "Computed": {
   "type": "object",
   "description": "evaluates a math expression over named numeric inputs",
   "properties": {
    "component": {
     "const": "Computed"
    },
    "expr": {
     "description": "string — JS-safe math using named vars e.g. 'a + b'"
    },
    "inputs": {
     "description": "object — { varName: '#nodeId.field' }"
    },
    "format": {
     "description": "string (optional) — '0,0' / '0.0%' / 'HH:mm:ss'"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "value",
    "display"
   ]
  },
  "ArrayFilter": {
   "type": "object",
   "description": "filters a source array by case-insensitive substring match on one field",
   "properties": {
    "component": {
     "const": "ArrayFilter"
    },
    "source": {
     "description": "array (optional) — static rows; or pushed in via wire (see wire_inputs)"
    },
    "filterKey": {
     "description": "string — object field to match against (default 'label')"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "output"
   ]
  },
  "StringValidator": {
   "type": "object",
   "description": "validates a string against a regex pattern",
   "properties": {
    "component": {
     "const": "StringValidator"
    },
    "source": {
     "description": "#nodeId.value"
    },
    "pattern": {
     "description": "string — regex, max 200 chars (bad/overlong pattern degrades to passthrough)"
    },
    "errorMessage": {
     "description": "string — emitted on errorMessage while invalid"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "isValid",
    "isNotValid",
    "isInvalid",
    "errorMessage"
   ]
  },
  "NumericThreshold": {
   "type": "object",
   "description": "compares a numeric source against a threshold",
   "properties": {
    "component": {
     "const": "NumericThreshold"
    },
    "source": {
     "description": "#nodeId.value"
    },
    "operator": {
     "description": "gt | gte | lt | lte | eq (default gte)"
    },
    "threshold": {
     "description": "number (default 0)"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "isTriggered",
    "isNotTriggered"
   ]
  },
  "StringTemplate": {
   "type": "object",
   "description": "string interpolation over named wire inputs — the text sibling of Computed; formatting, NOT derivation (boundary untouched)",
   "properties": {
    "component": {
     "const": "StringTemplate"
    },
    "template": {
     "description": "string with {var} slots, e.g. '{a} & {b} vs {c} & {d}'"
    },
    "inputs": {
     "description": "object — { varName: '#nodeId.field' }"
    },
    "fallbacks": {
     "description": "object (optional) — { varName: literal } used when the input is empty"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "value"
   ]
  },
  "RowBinder": {
   "type": "object",
   "description": "unpack delivered query rows back into ValueStores — form rehydration after reload; pure projection of ONE delivered array, no compute",
   "properties": {
    "component": {
     "const": "RowBinder"
    },
    "bind": {
     "description": "array of { match: {field: value}, take: field, into: storeId } — last matching row wins (append-only stores)"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "count"
   ]
  },
  "ObjectFields": {
   "type": "object",
   "description": "read named fields out of ONE object-valued store and expose them as scalars — RowBinder's sibling (that unpacks a delivered ARRAY, this unpacks a single delivered OBJECT). Exists because a wire is",
   "properties": {
    "component": {
     "const": "ObjectFields"
    },
    "fields": {
     "description": "array of field names to expose, e.g. [title, room_label, status] — declared rather than wholesale so an undeclared field warns per the wire error contract"
    },
    "source": {
     "description": "'#nodeId.field' — the object-valued store to read"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": "the declared `fields`, each defaulting to '' before the first delivery or when the source is not an object"
  },
  "StepNavigator": {
   "type": "object",
   "description": "tracks current step in a multi-step flow",
   "properties": {
    "component": {
     "const": "StepNavigator"
    },
    "totalSteps": {
     "description": "integer (default 2)"
    }
   },
   "required": [
    "component"
   ],
   "x-readableFields": [
    "activeIndex"
   ],
   "x-actionTargets": [
    "next",
    "prev",
    "jumpTo"
   ]
  },
  "badge": {
   "type": "object",
   "description": "coloured pill from a value->colour map",
   "properties": {
    "component": {
     "const": "badge"
    },
    "colors": {
     "description": "{ VALUE: '#hex' }"
    }
   },
   "required": [
    "component"
   ]
  },
  "sla_badge": {
   "type": "object",
   "description": "ok/warn/breach pill + elapsed time",
   "properties": {
    "component": {
     "const": "sla_badge"
    },
    "time_key": {
     "description": "column holding formatted duration"
    }
   },
   "required": [
    "component"
   ]
  },
  "claim": {
   "type": "object",
   "description": "owner avatar+name when owned; Claim button when unclaimed",
   "properties": {
    "component": {
     "const": "claim"
    }
   },
   "required": [
    "component"
   ],
   "x-extraProps": [
    "claim_key",
    "email_key",
    "name_key",
    "action_node",
    "key_mem_node"
   ],
   "x-columnKey": "_claim"
  },
  "resolve": {
   "type": "object",
   "description": "resolve button; hidden when already Resolved",
   "properties": {
    "component": {
     "const": "resolve"
    }
   },
   "required": [
    "component"
   ],
   "x-extraProps": [
    "resolve_key",
    "status_key",
    "action_node",
    "key_mem_node"
   ],
   "x-columnKey": "_resolve"
  },
  "delete": {
   "type": "object",
   "description": "delete-row button",
   "properties": {
    "component": {
     "const": "delete"
    }
   },
   "required": [
    "component"
   ],
   "x-extraProps": [
    "delete_key",
    "action_node",
    "key_mem_node"
   ],
   "x-columnKey": "_delete"
  }
 },
 "functions": {
  "elapsed_seconds": {
   "type": "object",
   "description": "integer seconds; requires interval to update with time",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "elapsed_seconds"
    },
    "args": {
     "type": "object",
     "properties": {
      "field": {
       "description": "row field with ISO timestamp"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "format_duration": {
   "type": "object",
   "description": "string e.g. '1h 23m'",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "format_duration"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "column holding seconds"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "threshold_by_field": {
   "type": "object",
   "description": "ok | warn | breach",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "threshold_by_field"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "column holding numeric value"
      },
      "key": {
       "description": "row field selecting the threshold set"
      },
      "thresholds": {
       "description": "{ KEY: { warn, breach } }"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "multiply_diff": {
   "type": "object",
   "description": "number — (a - b) * by, 2dp",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "multiply_diff"
    },
    "args": {
     "type": "object",
     "properties": {
      "a": {
       "description": "row field"
      },
      "b": {
       "description": "row field"
      },
      "by": {
       "description": "row field (optional, default 1)"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "pct_diff": {
   "type": "object",
   "description": "number — (a - b) / b * 100, 2dp; null if b = 0",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "pct_diff"
    },
    "args": {
     "type": "object",
     "properties": {
      "a": {
       "description": "row field"
      },
      "b": {
       "description": "row field"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "signal_threshold": {
   "type": "object",
   "description": "string — above/mid/below label",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "signal_threshold"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "row field"
      },
      "high": {
       "description": "number (default 70)"
      },
      "low": {
       "description": "number (default 30)"
      },
      "above": {
       "description": "string (default overbought)"
      },
      "below": {
       "description": "string (default oversold)"
      },
      "mid": {
       "description": "string (default neutral)"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "sma": {
   "type": "object",
   "description": "rolling simple moving average, joined by row index",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "sma"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "row field"
      },
      "window": {
       "description": "integer (default 20)"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "rsi": {
   "type": "object",
   "description": "rolling RSI, joined by row index",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "rsi"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "row field"
      },
      "window": {
       "description": "integer (default 14)"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "bband_upper": {
   "type": "object",
   "description": "rolling Bollinger upper band",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "bband_upper"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "row field"
      },
      "window": {
       "description": "integer (default 20)"
      },
      "mult": {
       "description": "number"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  },
  "bband_lower": {
   "type": "object",
   "description": "rolling Bollinger lower band",
   "returnType": "any",
   "properties": {
    "@call": {
     "const": "bband_lower"
    },
    "args": {
     "type": "object",
     "properties": {
      "src": {
       "description": "row field"
      },
      "window": {
       "description": "integer (default 20)"
      },
      "mult": {
       "description": "number"
      }
     }
    }
   },
   "required": [
    "@call"
   ]
  }
 },
 "$defs": {
  "anyComponent": {
   "oneOf": [
    {
     "$ref": "#/components/ValueStore"
    },
    {
     "$ref": "#/components/Timer"
    },
    {
     "$ref": "#/components/DerivedStore"
    },
    {
     "$ref": "#/components/Computed"
    },
    {
     "$ref": "#/components/ArrayFilter"
    },
    {
     "$ref": "#/components/StringValidator"
    },
    {
     "$ref": "#/components/NumericThreshold"
    },
    {
     "$ref": "#/components/StringTemplate"
    },
    {
     "$ref": "#/components/RowBinder"
    },
    {
     "$ref": "#/components/ObjectFields"
    },
    {
     "$ref": "#/components/StepNavigator"
    },
    {
     "$ref": "#/components/badge"
    },
    {
     "$ref": "#/components/sla_badge"
    },
    {
     "$ref": "#/components/claim"
    },
    {
     "$ref": "#/components/resolve"
    },
    {
     "$ref": "#/components/delete"
    }
   ],
   "discriminator": {
    "propertyName": "component"
   }
  },
  "anyFunction": {
   "oneOf": [
    {
     "$ref": "#/functions/elapsed_seconds"
    },
    {
     "$ref": "#/functions/format_duration"
    },
    {
     "$ref": "#/functions/threshold_by_field"
    },
    {
     "$ref": "#/functions/multiply_diff"
    },
    {
     "$ref": "#/functions/pct_diff"
    },
    {
     "$ref": "#/functions/signal_threshold"
    },
    {
     "$ref": "#/functions/sma"
    },
    {
     "$ref": "#/functions/rsi"
    },
    {
     "$ref": "#/functions/bband_upper"
    },
    {
     "$ref": "#/functions/bband_lower"
    }
   ]
  }
 }
}
