# Short shareable alias for the full-screen catalog playground (MCP Apps view).
# Fragment (#p=...) survives redirects — browsers reattach it client-side.
/play /surfaces/mcp-apps/play/ 302

# Conventional developer-portal aliases some crawlers/scanners probe literally.
# There is no console or dashboard (no accounts, no API keys) — all point at
# the one real developer page rather than 404ing (safe 301 redirects to public docs).
/console /developers/ 301
/dashboard /developers/ 301
/developer /developers/ 301
/developer-portal /developers/ 301
/portal /developers/ 301

# Predictable documentation, API reference, OpenAPI, auth, and webhook paths
# mapped directly to their published destinations.
/api /developers/ 301
/api-docs /api-docs/ 301
/api-reference /api-docs/ 301
/docs /docs/ 301
/docs/api /docs/ 301
/documentation /docs/ 301
/swagger /docs/ 301
/swagger-ui /docs/ 301
/swagger.json /openapi.json 301
/openapi.yaml /openapi.json 301
/api/openapi.json /openapi.json 301
/api/swagger.json /openapi.json 301
/.well-known/openapi.json /openapi.json 301
/.well-known/openapi.yaml /openapi.json 301
/auth /auth/ 301
/authentication /auth/ 301
/security /auth/ 301
/docs/auth /auth/ 301
/webhooks /webhooks/ 301
/docs/webhooks /webhooks/ 301
/events /webhooks/ 301
/webhook /webhooks/ 301
/ard.json /.well-known/ard.json 301
/.well-known/ard /.well-known/ard.json 301
