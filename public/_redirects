# Short shareable alias for the full-screen catalog playground (MCP Apps view).
# Fragment (#p=...) survives redirects — browsers reattach it client-side.
/play /surfaces/mcp-apps/play/ 302

# Conventional developer-portal aliases some crawlers/scanners probe literally.
# There is no console or dashboard (no accounts, no API keys) — both point at
# the one real developer page rather than 404ing.
/console /developers/ 301
/dashboard /developers/ 301

# Same reasoning for conventional API-docs paths: no literal /api or
# /api-reference page exists (the real reference is openapi.json, linked
# prominently from /developers/), so send probes there instead of a bare 404.
/api /developers/ 301
/api-docs /developers/ 301
/api-reference /developers/ 301
/docs /developers/ 301
/docs/api /developers/ 301
/documentation /developers/ 301
