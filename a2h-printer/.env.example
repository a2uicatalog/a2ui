# Copy to .env and fill in. Never commit the real .env.

# From your Slack app's "Basic Information" page.
SLACK_SIGNING_SECRET=

# From your Slack app's "OAuth & Permissions" page (xoxb-...). Required bot
# scopes: chat:write (posting), plus whatever your app's manifest declares
# for the interactivity/modal paths (see README.md).
SLACK_BOT_TOKEN=

# Default channel render_reading_to_slack / `/a2ui show` posts to when no
# channel is specified. Defaults to #general if unset.
SLACK_DEFAULT_CHANNEL=#general

# Shared bearer token for the /mcp endpoint. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Overrides the .well-known/mcp/server-card.json discovery manifest's
# serverUrl, instead of deriving it from the inbound request's Host header.
# Only needed if you're behind a proxy that doesn't forward a trustworthy
# Host header — see routes/wellknown.js's header comment. Example:
#   PUBLIC_BASE_URL=https://a2ui.example.com
# PUBLIC_BASE_URL=

# Optional: switch storage from the default SQLite file to Postgres. Leave
# unset to use SQLite (see README.md's cost/durability tradeoff before
# deciding — Postgres is not implemented yet, see storage/index.js).
# DATABASE_URL=

# Microsoft Teams surface — optional. Leave both unset to run Slack-only;
# /api/messages fails closed with a clear "not configured" error rather than
# refusing to boot. From your Azure Bot resource's registration (see
# README.md's Teams setup section for the full walkthrough).
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# 'botframework.com' is correct for a MultiTenant Azure Bot registration
# (the common case) — only change this if you registered SingleTenant.
# TEAMS_AUTH_TENANT=botframework.com

# Dev-only: skip inbound JWT verification for /api/messages, so
# scripts/smoke/teams.sh can exercise the route without a real Azure Bot
# registration. Inert unless NODE_ENV is also NOT 'production' (checked in
# teams-security.js) — cannot be armed in a production image. NEVER set this
# outside local development.
# TEAMS_DEV_BYPASS_AUTH=1

# D-bucket image-render fallback — reuses an EXISTING, already-live
# cloud-run-renderer deployment's signed /render.png rather than standing up
# a second render service. Both optional TOGETHER for Slack/Teams (only
# needed for exotic atoms with no native block), but REQUIRED for Google
# Chat below — Chat has no native block compiler at all, so every reply
# needs this to display anything.
# RENDER_SIGNING_KEY=
# RENDER_BASE_URL=

# Google Chat surface — optional, same posture as Teams above, but ALSO
# needs RENDER_SIGNING_KEY/RENDER_BASE_URL set (see README.md's Chat setup
# section). From the Chat API's Configuration page: one or two
# "Authentication Audience" values (this service's own /chat URL, and/or a
# numeric project number — comma-separated if both; see lib/chat-security.js
# for why these are two genuinely different verification paths).
# CHAT_AUDIENCE=

# Only relevant if you've deployed --no-allow-unauthenticated (this
# package's own deploy.sh always uses --allow-unauthenticated, so leave
# this unset unless you've modified that) — see lib/chat-security.js.
# TRUST_CLOUD_RUN_IAM=1

# Dev-only: skip inbound token verification for /chat, so
# scripts/smoke/chat.sh can exercise the route without a real Chat app
# registration. Same NODE_ENV-gated safety as TEAMS_DEV_BYPASS_AUTH above —
# NEVER set this outside local development.
# CHAT_DEV_BYPASS_AUTH=1

# Chat PROACTIVE posting (an agent pushing content into a space via /mcp's
# render_reading_to_chat, outside any inbound webhook) needs its own
# credential — a service account, but SPECIFICALLY the one registered as
# this Chat app's own identity in the Chat API configuration, not just any
# GCP principal. On Cloud Run, deploy/cloud-run/deploy.sh's
# CHAT_SERVICE_ACCOUNT var handles this with ZERO key file (Application
# Default Credentials resolve it via the metadata server automatically).
# This var is the fallback for hosts with no attachable service identity
# (Fly.io/Render/bare VPS) — paste the FULL JSON key file contents as one
# line. Leave unset on Cloud Run if you set CHAT_SERVICE_ACCOUNT instead.
# GOOGLE_SERVICE_ACCOUNT_KEY=
