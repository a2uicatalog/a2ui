# Copy to .env and fill in. Never commit the real .env.
#
# This is CopilotKit Channels mode — hosted, not sovereign. It runs through
# CopilotKit's own "Intelligence" backend, unlike ../src/ (self-hosted mode).
# See README.md's install steps for exactly how to obtain each of these —
# several require an interactive step (browser login, a TUI) that cannot be
# scripted; README.md marks each one explicitly.

# From `npx copilotkit login` + `npx copilotkit project select` (interactive
# — see README.md step 1-2). Minted by the CopilotKit dashboard/CLI.
INTELLIGENCE_API_KEY=

# CopilotKit's realtime gateway. NOT auto-provisioned by `project select` —
# a known CLI gap (their tracked issue OSS-714, see README.md) — set this
# exact value by hand:
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai

# The Intelligence Channel name for the Slack bot (channel.ts). Created via
# `npx copilotkit channels add --adapter slack` (interactive — see README.md
# step 3). Must match whatever name you gave that channel.
CHANNEL_CODE=

# Which model the agent runs on. vertex:gemini-2.5-flash is what this bridge
# was live-tested against; any model @copilotkit/runtime's BuiltInAgent
# supports should work, but is unverified here.
A2UI_MODEL=vertex:gemini-2.5-flash

# Required if A2UI_MODEL uses vertex: — your GCP project + region for Vertex
# AI, using Application Default Credentials (run `gcloud auth application-
# default login` — interactive — rather than a separate API key).
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# The SAME Secret Manager secret (render-signing-key) your self-hosted mode
# (../src/) already uses, if you have one deployed — reusing it means zero
# new render infrastructure. If you don't have a self-hosted deployment,
# generate any 32+ byte random string; the value only needs to match between
# whatever signs URLs and whatever renderer verifies them.
RENDER_SIGNING_KEY=

# Defaults to the existing public a2uicatalog renderer — override only if
# you're running your own cloud-run-renderer instance.
# A2UI_RENDERER_URL=https://a2ui-renderer-public-ggbfj7axza-uc.a.run.app

# Which a2uicatalog MCP server the agent's list_catalogs/get_catalog calls
# hit. Defaults to the public hosted one — override only if pointing at a
# self-hosted ../src/ deployment's own /mcp instead.
# A2UICATALOG_MCP_URL=https://a2uicatalog.ai/mcp

# Optional: only set this if you have your own a2uicatalog.ai demo-rate-
# limit-bypass key. Omit entirely for normal public rate limits — that's a
# working default, not a broken one. NEVER hardcode this value in source.
# A2UICATALOG_DEMO_BYPASS_KEY=

# --- Telegram (optional — telegram-channel.ts) ---
# From @BotFather on Telegram. No webhook/URL setup needed (long-polling).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_CODE=a2h-printer-telegram

# --- WhatsApp (optional — whatsapp-channel.ts) ---
# UNPROVEN — never live-tested, only confirmed by reading CopilotKit's own
# compiled dispatcher. Needs a real Meta Developer app + WhatsApp Business
# number (see README.md's WhatsApp section) — no quick-start path like
# Telegram's bot token. Also needs a PUBLIC webhook URL (no long-polling
# mode) — locally, tunnel port WHATSAPP_PORT with e.g. `ngrok http 3000`.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PORT=3000
# WHATSAPP_CHANNEL_CODE=a2h-printer-whatsapp

# --- Teams (optional — teams-channel.ts) ---
# Omit all three for anonymous local dev via the M365 Agents Playground (see
# README.md). Only needed for a real Azure Bot / tenant.
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_TENANT_ID=
# TEAMS_PORT=3978
# TEAMS_CHANNEL_CODE=a2h-printer-teams
