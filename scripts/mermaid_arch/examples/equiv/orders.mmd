%% title: Orders
%% msg: browser->cdn "GET /orders"
flowchart LR
  browser([Browser]):::user
  subgraph edge[Edge]
    cdn[CDN]
    gw[API gateway]
  end
  subgraph vpc[VPC]
    auth[Auth]:::tool
    queue[[Job queue]]
    worker[Worker]
    pg[(Postgres)]
    s3[(Object store)]
  end
  browser -->|HTTPS| cdn
  cdn -->|/api| gw
  gw -->|verify JWT| auth
  gw -->|query| pg
  gw -.->|enqueue| queue
  queue -.-> worker
  worker --> pg
  cdn -.->|cache miss| s3
  worker -->|put file| s3
